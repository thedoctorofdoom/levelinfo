/*----------------------\
   LevelInfo by Tekish
\----------------------*/

class levelinfobridge
{
	ui private static int getconsoleplayer()
	{
		return consoleplayer;
	}

	ui private static int gethazard()
	{
		playerinfo player = players[consoleplayer];
		return player.hazardcount;
	}

	ui private static int getmorph()
	{
		playerinfo player = players[consoleplayer];
		return player.morphtics;
	}

	ui private static int getpoison()
	{
		playerinfo player = players[consoleplayer];
		return player.poisoncount;
	}

	ui private static int gettotaltime()
	{
		return level.totaltime;
	}
}

class levelinforenderer : eventhandler
{
	const LI_BASECOLOR = font.CR_WHITE;
	const LI_STALETICS = 140;

	string litexts;
	string livalues;
	int lilastupdate;

	/*--------------------\
	   ACS Entry Points
	\--------------------*/

	play static void pushrows(string texts, string values)
	{
		let renderer = levelinforenderer(eventhandler.find("levelinforenderer"));

		if (renderer == null)
			return;

		renderer.litexts = texts;
		renderer.livalues = values;
		renderer.lilastupdate = level.time;
	}

	play static void clear()
	{
		let renderer = levelinforenderer(eventhandler.find("levelinforenderer"));

		if (renderer == null)
			return;

		renderer.litexts = "";
		renderer.livalues = "";
		renderer.lilastupdate = -LI_STALETICS * 2;
	}

	/*----------\
	   Drawing
	\----------*/

	// getfont() is used rather than findfont() because SHAFONT and SHADFONT are
	// bare single-lump FON2 files that nothing registers at startup; only
	// getfont() builds a font object for them on demand.
	private ui static font resolvefont(playerinfo player)
	{
		font resolved = null;

		switch (cvar.getcvar("li_font", player).getint())
		{
			case 1: // Doom
				resolved = font.getfont("SHADFONT");
				break;
			case 2: // Mod Small Font
				resolved = font.getfont("SmallFont");
				break;
			case 3: // Mod Big Font
				resolved = font.getfont("BigFont");
				break;
			case 4: // Custom
			{
				string customname = cvar.getcvar("li_fontcustom", player).getstring();

				if (customname.length() > 0)
					resolved = font.getfont(customname);

				break;
			}
			default: // LevelInfo
				resolved = font.getfont("SHAFONT");
				break;
		}

		if (resolved == null)
			resolved = font.getfont("SmallFont");

		if (resolved == null)
			resolved = smallfont;

		return resolved;
	}

	override void renderoverlay(renderevent e)
	{
		string texts = litexts;
		string values = livalues;

		if (texts.length() == 0)
			return;

		// a negative age means the level changed out from under the last push
		int age = level.time - lilastupdate;

		if (age < 0 || age > LI_STALETICS)
			return;

		playerinfo player = players[consoleplayer];

		if (player == null)
			return;

		if (!cvar.getcvar("li_visible", player).getint())
			return;

		if (automapactive && !cvar.getcvar("li_showonmap", player).getint())
			return;

		font renderfont = resolvefont(player);

		if (renderfont == null)
			return;

		// reproduces the clean-scaled space HudMessage drew into when no
		// SetHudSize was ever issued; a smaller canvas renders larger text
		int scale = cvar.getcvar("li_scale", player).getint();

		if (scale < 0 || scale > 8)
			scale = 0;

		double canvaswidth = double(screen.getwidth()) / double(scale ? scale : max(1, cleanxfac));
		double canvasheight = double(screen.getheight()) / double(scale ? scale : max(1, cleanyfac));

		// the two strings are lockstep; blank entries are deliberate separator
		// rows and still consume a row of height
		array<string> labels;
		array<string> numbers;

		texts.split(labels, "\n");
		values.split(numbers, "\n");

		int labelcount = labels.size();
		int numbercount = numbers.size();
		int rowcount = max(labelcount, numbercount);

		if (rowcount == 0)
			return;

		int rowheight = max(1, renderfont.getheight());
		int cellwidth = max(1, renderfont.stringwidth("0"));
		int columngap = max(4, renderfont.stringwidth(" ") * 2);
		int labelwidth = 0;
		int numberwidth = 0;

		for (int i = 0; i < labelcount; i++)
			labelwidth = max(labelwidth, renderfont.stringwidth(labels[i]));

		for (int i = 0; i < numbercount; i++)
			numberwidth = max(numberwidth, renderfont.stringwidth(numbers[i]));

		double blockwidth = double(labelwidth + columngap + numberwidth);
		double blockheight = double(rowcount * rowheight);
		bool alignx, aligny;
		double xfraction, yfraction, marginx, marginy;

		switch (cvar.getcvar("li_position", player).getint())
		{
			case 0: // Custom
			{
				int offsetx = cvar.getcvar("li_x", player).getint();
				int offsety = cvar.getcvar("li_y", player).getint();

				if (offsetx < 0 || offsetx > 90)
					offsetx = 0;

				if (offsety < 0 || offsety > 50)
					offsety = 0;

				alignx = cvar.getcvar("li_alignx", player).getint();
				aligny = cvar.getcvar("li_aligny", player).getint();
				xfraction = alignx ? 1.0 : 0.0;
				yfraction = aligny ? 1.0 : 0.0;
				marginx = double((offsetx + 1) * cellwidth);
				marginy = double((offsety + 1) * rowheight);
				break;
			}
			case 1: // Top Left
				alignx = false;
				aligny = false;
				xfraction = 0.0;
				yfraction = 0.0;
				marginx = double(cellwidth);
				marginy = double(rowheight);
				break;
			case 2: // Center Left
				alignx = false;
				aligny = false;
				xfraction = 0.0;
				yfraction = 0.5;
				marginx = double(cellwidth);
				marginy = 0.0;
				break;
			case 3: // Bottom Left
				alignx = false;
				aligny = true;
				xfraction = 0.0;
				yfraction = 1.0;
				marginx = double(cellwidth);
				marginy = double(rowheight);
				break;
			case 5: // Center Right
				alignx = true;
				aligny = false;
				xfraction = 1.0;
				yfraction = 0.5;
				marginx = 0.0;
				marginy = 0.0;
				break;
			case 6: // Bottom Right
				alignx = true;
				aligny = true;
				xfraction = 1.0;
				yfraction = 1.0;
				marginx = 0.0;
				marginy = double(rowheight);
				break;
			default: // Top Right, also the fallback
				alignx = true;
				aligny = false;
				xfraction = 1.0;
				yfraction = 0.0;
				marginx = 0.0;
				marginy = double(rowheight);
				break;
		}

		// measuring the block first keeps its outer edge pinned to the anchor,
		// so a right-anchored block grows inward instead of past the margin
		double blockx = (xfraction * (canvaswidth - blockwidth)) + (alignx ? -marginx : marginx);
		double blocky = (yfraction * (canvasheight - blockheight)) + (aligny ? -marginy : marginy);
		double numberx = blockx + double(labelwidth + columngap);
		bool alignvalue = cvar.getcvar("li_alignvalue", player).getint();
		int opacity = cvar.getcvar("li_opacity", player).getint();

		if (opacity < 10)
			opacity = 10;
		else if (opacity > 100)
			opacity = 100;

		double alpha = double(opacity) / 100.0;

		for (int i = 0; i < rowcount; i++)
		{
			double rowy = blocky + double(i * rowheight);

			if (i < labelcount && labels[i].length() > 0)
			{
				screen.drawtext(renderfont, LI_BASECOLOR, blockx, rowy, labels[i], DTA_Alpha, alpha, DTA_KeepRatio, true, DTA_VirtualHeightF, canvasheight, DTA_VirtualWidthF, canvaswidth);
			}

			if (i < numbercount && numbers[i].length() > 0)
			{
				double rowx = numberx;

				if (alignvalue)
					rowx += double(numberwidth - renderfont.stringwidth(numbers[i]));

				screen.drawtext(renderfont, LI_BASECOLOR, rowx, rowy, numbers[i], DTA_Alpha, alpha, DTA_KeepRatio, true, DTA_VirtualHeightF, canvasheight, DTA_VirtualWidthF, canvaswidth);
			}
		}
	}
}